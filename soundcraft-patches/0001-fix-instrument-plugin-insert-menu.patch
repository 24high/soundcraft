+        s.tracks
+            .iter()
+            .filter(|t| t.id != id && t.kind.is_midi() && t.instrument.is_some())
+            .map(|t| (t.id, t.name.clone(), src.midi_out.contains(&t.id)))
+            .collect()
+    };
+    if targets.is_empty() {
+        ui.label(egui::RichText::new("No other track has an instrument.").color(Tokens::current().text_dim));
+    }
