+/// A 0..1 VST3 event value as a MIDI 1.0 data byte (0..=127).
+fn midi_byte(v: f32) -> Option<u8> {
+    if !v.is_finite() {
+        return None;
+    }
+    let x = (f64::from(v) * 127.0).round();
+    u8::try_from(x.clamp(0.0, 127.0) as i64).ok()
+}
