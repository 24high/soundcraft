+            levels.push(std::mem::take(&mut left));
+            break;
+        }
+        for &i in &ready {
+            if let Some(x) = done.get_mut(i) {
+                *x = true;
+            }
+        }
+        left.retain(|&i| !done.get(i).copied().unwrap_or(true));
+        levels.push(ready);
+    }
